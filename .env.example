# =============================================================================
# bot-futures — ficheiro de exemplo. Copie para .env e preencha.
#
#   copy .env.example .env      (Windows)
#   cp   .env.example .env      (Linux/macOS)
#
# O .env NUNCA deve ser versionado — está no .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# SEGURANÇA — obrigatório antes do primeiro arranque
# -----------------------------------------------------------------------------
# Chave usada para encriptar as credenciais da exchange guardadas na base de
# dados (Fernet/AES). GERE A SUA — não use este valor de exemplo:
#
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# A APLICAÇÃO RECUSA-SE A ARRANCAR se esta chave estiver em falta, for o valor
# de exemplo abaixo, ou tiver menos de 32 caracteres. É deliberado: encriptar
# com uma chave pública é pior do que não encriptar, porque dá a ilusão de que
# as credenciais estão protegidas quando não estão.
#
# Se esta chave mudar, as credenciais já guardadas deixam de poder ser lidas e
# têm de ser reintroduzidas pelo dashboard. Guarde-a em lugar seguro.
APP_SECRET=gere_o_seu_com_secrets_token_hex_32

# -----------------------------------------------------------------------------
# CREDENCIAIS DA EXCHANGE
# -----------------------------------------------------------------------------
# NÃO é preciso preencher aqui. O caminho recomendado é introduzi-las pelo
# dashboard, que as guarda encriptadas na base de dados com o APP_SECRET acima.
# As linhas abaixo existem apenas como alternativa para ambientes automatizados.
#
# BINANCE_TESTNET_API_KEY=
# BINANCE_TESTNET_SECRET=
# BINANCE_LIVE_API_KEY=
# BINANCE_LIVE_SECRET=

# -----------------------------------------------------------------------------
# MODO DE EXECUÇÃO
# -----------------------------------------------------------------------------
# testnet = ambiente de simulação da Binance (recomendado)
# live    = conta real — use por sua conta e risco
TRADING_MODE=testnet

# -----------------------------------------------------------------------------
# GESTÃO DE RISCO
# -----------------------------------------------------------------------------
PORTFOLIO_VALUE_USD=1000     # capital de referência para o dashboard
RISK_PER_TRADE_PCT=2.0       # % do saldo arriscada por trade
DEFAULT_LEVERAGE=3           # alavancagem mínima (sobe sozinha se o stop for apertado)
MAX_TRADES_PER_DAY=10        # NOTA: lido mas ainda não aplicado no motor
MAX_OPEN_POSITIONS=5         # posições abertas em simultâneo
MAX_PER_SIDE=2               # máximo por lado (long/short) — limita correlação

# -----------------------------------------------------------------------------
# ESTRATÉGIA
# -----------------------------------------------------------------------------
# auto_v2 = decisor por regime diário (lateral / bull / bear)
# Ver bot/strategies/__init__.py para a lista completa.
STRATEGY_MODE=auto_v2

SYMBOLS=BTC/USDC:USDC,ETH/USDC:USDC,SOL/USDC:USDC,BNB/USDC:USDC,XRP/USDC:USDC

# -----------------------------------------------------------------------------
# SERVIDOR E SESSÃO
# -----------------------------------------------------------------------------
# 127.0.0.1 = so aceita ligacoes desta maquina (predefinicao segura).
# 0.0.0.0 = aceita de toda a rede local — so faca isto de proposito, e leia a
# seccao "Expor na rede local" do README antes.
API_HOST=127.0.0.1
API_PORT=8080
SESSION_MAX_AGE_HOURS=24     # validade do cookie de sessão
SECURE_COOKIES=false         # ponha true se servir por HTTPS

# -----------------------------------------------------------------------------
# UTILIZADOR DO DASHBOARD
# -----------------------------------------------------------------------------
# As credenciais do dashboard vivem na base de dados (senha em hash scrypt).
# No primeiro arranque, se não existir nenhuma, é semeada a partir destas duas
# variáveis — defina-as, arranque uma vez, e depois remova-as deste ficheiro.
# Reposição a qualquer momento: python -m tools.reset_auth --set-password NOVA
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=mude_esta_senha_antes_do_primeiro_arranque
